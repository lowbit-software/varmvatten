# Copy to .env (chmod 600) and fill in.

# Token from Cloudflare Zero Trust -> Networks -> Tunnels -> your tunnel.
CLOUDFLARE_TUNNEL_TOKEN=

# uid/gid of the host user that owns ~/.config/myuplink (run: id -u; id -g).
# The webapp container runs as this user so it can read/write the token files.
APP_UID=1000
APP_GID=1000
