# Copy to .env (chmod 600) and fill in.

# Token from Cloudflare Zero Trust -> Networks -> Tunnels -> your tunnel.
CLOUDFLARE_TUNNEL_TOKEN=

# uid/gid of the host user that owns ~/.config/myuplink (run: id -u; id -g).
# The webapp container runs as this user so it can read/write the token files.
APP_UID=1000
APP_GID=1000

# Which address the webapp publishes port 5000 on. Unset means 127.0.0.1:
# reachable only from this host, with the Cloudflare tunnel as the only way in.
# Set 0.0.0.0 to also serve the LAN -- useful for local clients that would
# otherwise have to go out through the tunnel and come back.
#
# A single interface address works too, but it unbinds loopback. deploy.sh
# reads this value and health-checks the right address, so deploys survive it;
# the curl examples in README.md still assume 127.0.0.1.
APP_BIND=127.0.0.1
