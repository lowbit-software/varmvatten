# Copy to .env (chmod 600) and fill in.

# Token from Cloudflare Zero Trust -> Networks -> Tunnels -> your tunnel.
CLOUDFLARE_TUNNEL_TOKEN=

# uid/gid of the host user that owns ~/.config/myuplink (run: id -u; id -g).
# The webapp container runs as this user so it can read/write the token files.
APP_UID=1000
APP_GID=1000

# Nothing is published on the host by default: the Cloudflare tunnel is the
# only way in. To also serve the LAN on port 5000 -- useful for local clients
# that would otherwise go out through the tunnel and come back -- opt in to the
# overlay. APP_BIND then picks the address (default all interfaces, which
# includes loopback; a single interface address unbinds loopback). deploy.sh
# does not use this port, so it is unaffected either way.
# COMPOSE_FILE=docker-compose.yml:docker-compose.lan.yml
# APP_BIND=0.0.0.0
